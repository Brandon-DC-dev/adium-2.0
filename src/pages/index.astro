---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import TitleSection from "@/components/TitleSection.astro";
import Agendas from "@/components/Agendas.astro";
import File from "@/components/icons/File.astro";
import Taps from "@/components/Taps.astro";
---

<Layout
  title="Asofarma - Sitio web oficial"
  description="Asofarma">
  <main class="px-4 max-w-7xl mx-auto">
    <SectionContainer class="py-5 md:py-20">
      <Hero />
    </SectionContainer>
  </main>
  <div class="space-y-24 max-w-7xl mx-auto px-4">

    
    <SectionContainer id="agendas">
      <TitleSection>
        <File class="size-8" />
        Agendas
      </TitleSection>
      <Agendas />
    </SectionContainer>


    <SectionContainer id="taps">
      <TitleSection>
        <File class="size-8" />
        Productos de interés
      </TitleSection>
      <Taps />
    </SectionContainer>
  </div>
</Layout>
